# SystemaOps backend — environment template.
# Copy to `.env` (never commit `.env`) and fill in real values.
# All values below are placeholders or safe local defaults.
#
# DATABASE IS INTERNAL ONLY (Docker Compose `mongodb` service).
# Never point MONGO_URI at Atlas / Firebase / Supabase / Neon /
# Railway / Render / any external managed database.

# MongoDB connection string.
# - Inside compose (backend container): Docker internal DNS name:
#   MONGO_URI=mongodb://mongodb:27017/systemaops
# - Host-side dev (`npm run dev` in Server/): loopback binding
#   provided by docker-compose.override.yml:
MONGO_URI=mongodb://127.0.0.1:27017/systemaops
# With auth enabled (see MONGO_ROOT_* in root .env.example):
# MONGO_URI=mongodb://systemaops_app:CHANGE_ME@127.0.0.1:27017/systemaops?authSource=systemaops

# HTTP port the API listens on.
PORT=5000

# Set to "production" in deployed environments. Enables the
# production error handler (no stack traces / messages to clients).
NODE_ENV=production

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to 1 when running behind the production reverse proxy
# (docker-compose), so rate limiting sees real client IPs.
# Leave unset for direct deployments.
TRUST_PROXY=

# Transactional email (Resend). REQUIRED for password-reset delivery:
# a valid key from https://resend.com/api-keys. Free tier is sufficient
# for admin password-reset volume. Without a valid key, recovery tokens
# are created but no email can be delivered (check backend logs for the
# provider error). Form submissions still succeed; founder emails skip.
RESEND_API_KEY=
# Verified sender identity, e.g. SystemaOps Admin <no-reply@systemaops.com>.
# The domain MUST be verified in Resend (SPF/DKIM/DMARC) or delivery fails.
SENDER_EMAIL=
# Founder/admin notification inbox (also receives form-lead emails).
FOUNDER_EMAIL=

# Admin platform auth. REQUIRED in production (backend refuses to sign
# sessions without it). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real value. Dev-only fallback is ephemeral (sessions die on restart).
ADMIN_JWT_SECRET=
# Set to 1 when serving the admin app over HTTPS (secure cookies).
# Leave unset for plain-HTTP local development.
COOKIE_SECURE=

# Admin app origin used to build password-reset links (trusted config, never derived from request Host).
ADMIN_APP_ORIGIN=http://localhost
# Password-reset token lifetime in minutes (1-60, default 30).
RESET_TOKEN_TTL_MINUTES=30

# Transactional email (Resend). REQUIRED for password-reset delivery:
# a valid key from https://resend.com/api-keys. Free tier is sufficient
# for admin password-reset volume. Without it, recovery tokens are
# created but no email can be delivered (check backend logs for the
# provider error). Form submissions still succeed; founder emails skip.
RESEND_API_KEY=
# Verified sender identity, e.g. SystemaOps Admin <no-reply@systemaops.com>.
# The domain MUST be verified in Resend (SPF/DKIM/DMARC) or delivery fails.
SENDER_EMAIL=
# Founder/admin notification inbox (also receives form-lead emails).
FOUNDER_EMAIL=
