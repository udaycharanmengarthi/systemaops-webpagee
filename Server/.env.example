# SystemaOps backend — environment template.
# Copy to `.env` (never commit `.env`) and fill in real values.
# All values below are placeholders or safe local defaults.

# MongoDB connection string. Production uses MongoDB Atlas;
# local development can point at a local mongod.
# Example: mongodb://127.0.0.1:27017/systemaops
MONGO_URI=

# HTTP port the API listens on.
PORT=5000

# Set to "production" in deployed environments. Enables the
# production error handler (no stack traces / messages to clients).
NODE_ENV=production

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to 1 when running behind the production reverse proxy
# (docker-compose), so rate limiting sees real client IPs.
# Leave unset for direct deployments.
TRUST_PROXY=

# Transactional email (Resend). If unset, the API still accepts
# submissions; founder notification emails are skipped safely.
RESEND_API_KEY=
SENDER_EMAIL=
FOUNDER_EMAIL=
