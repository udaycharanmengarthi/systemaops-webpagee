# SystemaOps stack — Docker Compose environment template.
# Copy to `.env` (never commit `.env`) and fill in real values.
# All values below are placeholders or safe local defaults.
#
# The database is INTERNAL ONLY (compose `mongodb` service on the
# default Docker network — no published ports). Never point MONGO_URI
# at Atlas / Firebase / Supabase / Neon / Railway / Render / AWS /
# any external managed database.

# Backend connection string. Pinned inside docker-compose.yml to the
# internal Docker DNS name (mongodb://mongodb:27017/systemaops) — there
# is intentionally NO override here: compose interpolation reads the
# invoking shell, and a host-exported MONGO_URI once silently repointed
# a container at the wrong database. Auth-enabled deployments should
# use a dedicated override file (see Server/docs/DATABASE.md).

# Database name created on first init.
MONGO_DATABASE=systemaops

# Optional MongoDB root credentials. ONLY read on FIRST init of an
# EMPTY volume (existing volumes are untouched). Leave empty to run
# without auth behind Docker network isolation. NEVER commit values.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Transactional email (consumed by the backend via compose env_file).
# If unset, form submissions still succeed; founder emails are skipped.
RESEND_API_KEY=
SENDER_EMAIL=
FOUNDER_EMAIL=

# Password-reset link origin (trusted config, never derived from request Host).
ADMIN_APP_ORIGIN=http://localhost
# Password-reset token lifetime in minutes (1-60, default 30).
RESET_TOKEN_TTL_MINUTES=30
