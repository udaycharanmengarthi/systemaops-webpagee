# Public, build-time frontend settings only.
#
# Vite embeds every VITE_* value into the JavaScript sent to the browser.
# NEVER put a Stripe secret key (sk_...), webhook signing secret (whsec_...),
# database credential, or any other private value in this file.
#
# A Stripe publishable key (pk_...) is public by design, but this project uses
# Stripe-hosted Checkout, not Stripe.js, so it is not required here.

# Leave empty to use same-origin /api (Vite dev proxy and the production
# reverse proxy both serve it). Set only for a standalone frontend origin.
VITE_API_BASE_URL=

# Real Stripe Checkout is the default in development and production.
# The in-memory demo is opt-in and only exists in development. Uncomment to
# use the demo intentionally:
# VITE_ENABLE_MOCK_PAYMENT=true

# Development-only explicit opt-out of the paid flow. Production always uses
# the paid Stripe path regardless of this value.
# VITE_ENABLE_STRIPE_CHECKOUT=false
